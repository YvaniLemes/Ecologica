@model IEnumerable<Ecologica.Models.RegistroCarbonoModel>

@{
    ViewData["Title"] = "Histórico de Atividades";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-success fw-bold">📝 Gerenciar Meu Histórico</h2>
            <p class="text-muted mb-0">Consulte, altere ou remova seus registros de emissão de carbono.</p>
        </div>
        <a asp-controller="Atividade" asp-action="Create"
           class="btn btn-success fw-bold px-4 py-2 shadow-sm rounded-pill">
            ➕ Novo Cálculo
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-light border-bottom text-dark fw-bold">
                    <tr>
                        <th class="py-3">Atividade</th>
                        <th class="py-3">Quantidade</th>
                        <th class="py-3">Total (kgCO₂)</th>
                        <th class="py-3">Data do Registro</th>
                        <th class="py-3" style="width: 200px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-success text-start ps-4">
                                    @(item.AtividadeRelacionada != null ? item.AtividadeRelacionada.Nome : "Sem Atividade")
                                </td>
                                <td>@item.Quantidade</td>
                                <td class="fw-bold text-dark">@item.EmissaoTotal.ToString("F2")</td>
                                <td class="text-muted">@item.DataRegistro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary px-3 rounded-pill fw-bold">
                                            Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger px-3 rounded-pill fw-bold"
                                           onclick="return confirm('Tem certeza que deseja apagar permanentemente este registro do seu histórico?');">
                                            Excluir
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-5 text-muted">
                                <p class="mb-0 fs-5">Nenhum cálculo registrado ainda. Vamos começar?</p>
                                <a asp-controller="Atividade" asp-action="Create" class="text-success fw-bold">Clique aqui
                                    para criar seu primeiro registro</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>