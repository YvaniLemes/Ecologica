@model IEnumerable<Ecologica.Models.RegistroCarbonoModel>

@{
    ViewData["Title"] = "Ecologica - Dashboard";
    var perguntas = (List<Ecologica.Models.QuizViewModel>)ViewBag.PerguntasQuiz;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-success">Olá, @ViewBag.NomeUsuario!</h2>
            <p class="text-muted">Acompanhe seu impacto ambiental e aprenda como reduzi-lo.</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-plus-circle"></i> Nova Atividade
        </a>
    </div>

    <div class="row">
        <div class="col-lg-5">
            <!-- CONQUISTAS -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white border-0 pt-3">
                    <h5 class="card-title fw-bold"><i class="bi bi-trophy-fill text-warning"></i> Suas Conquistas</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-3">
                        @if (ViewBag.Conquistas != null)
                        {
                            @foreach (var conquista in (List<Ecologica.Models.Conquista>)ViewBag.Conquistas)
                            {
                                <div class="text-center" style="width: 100px;">
                                    <div class="badge rounded-circle bg-success p-3 mb-2 shadow-sm" title="@conquista.Descricao">
                                        <i class="bi bi-patch-check-fill" style="font-size: 1.5rem;"></i>
                                    </div>
                                    <p class="small fw-bold mb-0">@conquista.Nome</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- GRÁFICO -->
            <div class="card shadow-sm border-0 mb-4 text-center">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Impacto por Categoria</h5>
                    <canvas id="meuGrafico" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <!-- QUIZ -->
            <div class="card shadow-sm border-0 mb-4 bg-dark text-white">
                <div class="card-body">
                    <h5 class="card-title fw-bold"><i class="bi bi-controller text-info"></i> Desafio do Dia</h5>
                    <div id="quiz-container">
                        @if (perguntas != null)
                        {
                            @for (int i = 0; i < perguntas.Count; i++)
                            {
                                <div class="pergunta-card" id="pergunta-@i" style="@(i == 0 ? "" : "display:none")">
                                    <p class="mb-3">@perguntas[i].Pergunta</p>
                                    <div class="d-grid gap-2">
                                        @for (int j = 0; j < perguntas[i].Opcoes.Count; j++)
                                        {
                                            <button class="btn btn-outline-light btn-sm text-start" 
                                                    onclick="verificarResposta(@i, @j, @perguntas[i].RespostaCorretaIndice, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(perguntas[i].Explicacao))')">
                                                @perguntas[i].Opcoes[j]
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div id="resultado-quiz" class="mt-3 p-2 rounded small" style="display:none"></div>
                </div>
            </div>

            <!-- HISTÓRICO -->
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Atividade</th>
                                <th>Total (kgCO₂)</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var registro in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-success">@registro.AtividadeRelacionada?.Nome</td>
                                        <td>@registro.EmissaoTotal.ToString("N2")</td>
                                        <td>@registro.DataRegistro.ToShortDateString()</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // GRÁFICO
        const ctx = document.getElementById('meuGrafico');
        if (ctx) {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.LabelsGrafico)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(ViewBag.ValoresGrafico)),
                        backgroundColor: ['#198754', '#0d6efd', '#ffc107', '#dc3545'],
                        borderWidth: 0
                    }]
                }
            });
        }

        // LÓGICA DO QUIZ
        let processando = false;
        function verificarResposta(pIdx, escolhida, correta, explicacao) {
            if (processando) return;
            processando = true;

            const resDiv = document.getElementById("resultado-quiz");
            resDiv.style.display = "block";
            
            if (escolhida === correta) {
                resDiv.className = "mt-3 p-2 rounded small bg-success text-white";
                resDiv.innerHTML = "<strong>✅ Correto!</strong> " + explicacao;
            } else {
                resDiv.className = "mt-3 p-2 rounded small bg-danger text-white";
                resDiv.innerHTML = "<strong>❌ Errou!</strong> " + explicacao;
            }

            setTimeout(() => {
                document.getElementById(`pergunta-${pIdx}`).style.display = "none";
                let proxima = document.getElementById(`pergunta-${pIdx + 1}`);
                if (proxima) {
                    proxima.style.display = "block";
                    resDiv.style.display = "none";
                } else {
                    resDiv.className = "mt-3 p-2 rounded small bg-info text-white";
                    resDiv.innerHTML = "🏁 Parabéns! Você concluiu o desafio.";
                }
                processando = false;
            }, 4000);
        }
    </script>
}