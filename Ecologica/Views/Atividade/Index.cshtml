@model IEnumerable<Ecologica.Models.RegistroCarbonoModel>

@{
    ViewData["Title"] = "Dashboard - Ecologica";

    var perguntas = ViewBag.PerguntasQuiz as List<Ecologica.Models.QuizViewModel>;
    var conquistas = ViewBag.Conquistas as List<Ecologica.Models.Conquista>;
}

<div class="row mb-4" style="margin-top: -20px;">
    <div class="col-12 d-flex justify-content-between align-items-center bg-white p-3 shadow-sm"
         style="border-radius: 15px;">
        <div>


            <div class="mt-2">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-success fw-bold small">Progresso para Mestre Sustentável</span>
                    <span class="text-muted small">@ViewBag.ProgressoBarra%</span>
                </div>
                <div class="progress" style="height: 10px; border-radius: 5px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @(ViewBag.ProgressoBarra)%"
                         aria-valuenow="@ViewBag.ProgressoBarra" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
            </div>



                
            <div class="d-flex gap-2 mt-2 flex-wrap">
                <span class="badge bg-success px-3 py-2 shadow-sm" style="border-radius: 20px;">
                    🏆 Medalhas: @ViewBag.TotalMedalhas
                </span>

                <span class="badge bg-dark px-3 py-2 shadow-sm" style="border-radius: 20px;">
                    @ViewBag.RankingUsuario
                </span>
            </div>

            <p class="text-muted mb-0">Seu progresso está crescendo como uma planta bem cuidada.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button onclick="location.reload()" class="btn btn-success fw-bold px-4 py-2 shadow-sm"
                    style="border-radius: 25px;">
                🔄 Atualizar Painel
            </button>
            <a asp-action="Create" class="btn btn-success fw-bold px-4 py-2 shadow-sm" style="border-radius: 25px;">
                Nova Atividade
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5 d-flex flex-column gap-4">
        <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 20px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-success mb-0">
                    Suas Conquistas 🍀
                </h5>
                <form asp-action="ResetarConquistas" method="post">
                    <button type="submit" class="btn btn-success fw-bold px-4 py-2 shadow-sm"
                            style="border-radius: 25px;"
                            onclick="return confirm('Tem certeza que deseja reiniciar suas conquistas? Todo o seu progresso será perdido!')">
                        🔄 Reiniciar Conquistas
                    </button>
                </form>

            </div>

            <div class="d-flex flex-wrap gap-3 mt-2">
                @if (conquistas != null && conquistas.Any())
                {
                    foreach (var conquista in conquistas)
                    {
                        <div class="text-center" style="width: 80px;" title="@conquista.Descricao">
                            <div class="bg-light p-3 rounded-circle shadow-sm d-flex align-items-center justify-content-center mx-auto mb-2"
                                 style="width: 60px; height: 60px; border: 2px solid #ffb300;">
                                <span class="fs-3">🏅</span>
                            </div>
                            <span class="fw-bold text-dark d-block small lh-sm px-1"
                                  style="word-wrap: break-word; font-size: 0.8rem;">@conquista.Nome</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center w-100 py-3">
                        <p class="text-muted small mb-0">Nenhuma medalha conquistada ainda. Complete desafios no
                            Eco-Game!</p>
                        </div>
                    }
                </div>

                <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 20px; flex-grow: 1;">
                    <h5 class="fw-bold text-success mb-3">Impacto por Categoria</h5>
                    <div class="chart-container d-flex align-items-center justify-content-center"
                         style="position: relative; height:260px; width:100%">
                        <canvas id="graficoCarbono"></canvas>
                    </div>
                </div>
            </div>


        </div> <!-- FECHA col-lg-5 -->
        <div class="col-lg-7 d-flex flex-column gap-4">
            <div class="card border-0 shadow-sm p-4"
                 style="border-radius: 20px; background-color: #a5d6a7; min-height: 320px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Desafio do Dia 🍀</h5>
                    <span class="badge bg-white text-success fw-bold px-3 py-2 shadow-sm"
                          style="border-radius: 20px; font-size: 0.75rem;">ECO-GAME</span>
                </div>

                <div id="quiz-container" class="position-relative">
                    @if (perguntas != null && perguntas.Any())
                    {
                        for (int i = 0; i < perguntas.Count; i++)
                        {
                            var p = perguntas[i];
                            <div class="pergunta-card" id="pergunta-@i"
                                 style="display: @(i == 0 ? "block" : "none"); transition: opacity 0.4s ease;">
                                <p class="fs-5 text-dark fw-semibold mb-4">@p.Pergunta</p>
                                <div class="d-flex flex-column gap-3 mb-3">
                                    @for (int j = 0; j < p.Opcoes.Count; j++)
                                    {
                                        <button type="button"
                                                class="btn btn-light text-start p-3 border-0 btn-opcao-@i shadow-sm w-100 position-relative fw-medium option-button"
                                                style="border-radius: 15px; color: #2e7d32; transition: all 0.2s;"
                                                onclick='verificarResposta(@i, @p.Id, @j, @p.RespostaCorretaIndice, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.Explicacao)), event)'>
                                            @p.Opcoes[j]
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 bg-white rounded shadow-sm" style="border-radius: 15px;">
                            <h5 class="text-success fw-bold">🌱 Tudo limpo por hoje!</h5>
                            <p class="text-muted small px-3">Você respondeu todos os desafios disponíveis. Volte
                                amanhã!
                            </p>
                        </div>
                    }
                    <div id="resultado-quiz" class="p-3 mt-3 shadow-sm font-medium small"
                         style="display: none; border-radius: 15px; min-height: 60px;"></div>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 20px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-success mb-0">Histórico de Atividades</h5>
                    <a asp-action="Historico"
                       class="btn btn-link text-success fw-semibold p-0 text-decoration-none small">Ver
                        Completo
                        →</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="border-0">Atividade</th>
                                    <th class="border-0 text-center">Total (kgCO₂)</th>
                                    <th class="border-0 text-end">Data</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model.Take(5))
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@(item.AtividadeRelacionada?.Nome ?? "Outros")
                                            </td>
                                            <td class="text-center fw-bold text-danger">@item.EmissaoTotal.ToString("F2")
                                            </td>
                                            <td class="text-end text-muted small">@item.DataRegistro.ToString("dd/MM/yyyy")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3 small">Nenhuma atividade
                                            registrada
                                            ainda.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div> <!-- fecha card histórico -->
                </div> <!-- fecha col-lg-7 -->
            </div> <!-- fecha row -->
        </div> <!-- fecha container -->

        <style>
            .option-button:hover:not(:disabled) {
                background-color: #e8f5e9 !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
            }

            .option-button:disabled {
                opacity: 0.8;
                cursor: not-allowed;
            }
        </style>

        @section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                const ctx = document.getElementById('graficoCarbono');
                if (ctx) {
                const labelsGrafico = @Html.Raw(Json.Serialize(ViewBag.LabelsGrafico));
                const valoresGrafico = @Html.Raw(Json.Serialize(ViewBag.ValoresGrafico));

                if (labelsGrafico && labelsGrafico.length > 0) {

                const total = valoresGrafico.reduce((a, b) => a + b, 0);

                const labelsComPorcentagem = labelsGrafico.map((label, index) => {

                const valor = valoresGrafico[index] || 0;

                const porcentagem = total > 0
                ? ((valor / total) * 100).toFixed(1)
                : 0;

                return `${label} (${porcentagem}%)`;
                });

                new Chart(ctx, {
                type: 'doughnut',
                data: {
                labels: labelsComPorcentagem,
                datasets: [{
                data: valoresGrafico,
                backgroundColor: [
                '#e65100',
                '#ffb300',
                '#8e24aa',
                '#1e88e5',
                '#43a047',
                '#fb8c00'
                ],
                borderWidth: 2,
                borderColor: '#ffffff'
                }]
                },
                options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                legend: {
                position: 'bottom'
                }
                }
                }
                });

                }

                else {
                ctx.parentNode.innerHTML =
                `<p class="text-muted small">
                Insira sua primeira atividade para gerar o gráfico.
                </p>`;
                }

                } // FECHA O if (ctx)

                let processando = false;

                    
                function verificarResposta(cardIdx, questaoRealId, escolhida, correta, explicacao, event) {
                // 1. Impede que o clique se propague ou tente recarregar a página
                if (event) {
                event.preventDefault();
                event.stopPropagation();
                }

                if (processando) return;

                processando = true;

                const resDiv = document.getElementById("resultado-quiz");

                // Desabilita os botões da pergunta atual
                document.querySelectorAll(`.btn-opcao-${cardIdx}`).forEach(btn => btn.disabled = true);

                // Exibe o feedback
                resDiv.style.backgroundColor = (escolhida === correta) ? "#c8e6c9" : "#ffecb3";
                resDiv.style.color = (escolhida === correta) ? "#1b5e20" : "#5d4037";

                resDiv.innerHTML = `
                <div class="mb-2">${escolhida === correta ? "🍀 <strong>Perfeito!</strong>" : "🌿 <strong>Quase lá!</strong>"} ${explicacao}</div>
                <button type="button" class="btn btn-success btn-sm w-100" onclick="proximaPergunta(${cardIdx})">Avançar ➡️</button>
                `;
                resDiv.style.display = "block";

                fetch('/Atividade/ValidarRespostaQuiz', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `questaoIndice=${questaoRealId}&alternativaEscolhida=${escolhida}`
                }).catch(err => console.error(err));
                }

                function proximaPergunta(cardIdx) {
                const cardAtual = document.getElementById(`pergunta-${cardIdx}`);
                if (cardAtual) cardAtual.style.display = "none";
                let proxima = document.getElementById(`pergunta-${cardIdx + 1}`);
                if (proxima) {
                document.getElementById("resultado-quiz").style.display = "none";
                proxima.style.display = "block";
                processando = false;
                } else {
                document.getElementById("resultado-quiz").innerHTML = `<div class="text-center p-3"><h5>🏁 Bloco Concluído!</h5><button class="btn btn-success" onclick="location.reload()">Atualizar 🔄</button></div>`;
                }
                }
            </script>
        }