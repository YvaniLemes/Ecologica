@model IEnumerable<Ecologica.Models.RegistroCarbonoModel>

@{
    ViewData["Title"] = "Dashboard - Ecologica";
    var perguntas = ViewBag.PerguntasQuiz as List<Ecologica.Models.QuizViewModel>;
    var conquistas = ViewBag.Conquistas as List<Ecologica.Models.Conquista>;
}

<div class="row mb-4" style="margin-top: -20px;">
    <div class="col-12 d-flex justify-content-between align-items-center bg-white p-3 shadow-sm"
         style="border-radius: 15px;">
        <div>
            <div class="mt-2">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-success fw-bold small">Progresso para Mestre Sustentável</span>
                    <span class="text-muted small">@ViewBag.ProgressoBarra%</span>
                </div>
                <div class="progress" style="height: 10px; border-radius: 5px; width: 300px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @(ViewBag.ProgressoBarra)%"
                         aria-valuenow="@ViewBag.ProgressoBarra" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-2 flex-wrap">
                <span class="badge bg-success px-3 py-2 shadow-sm" style="border-radius: 20px;">🏆 Medalhas:
                    @ViewBag.TotalMedalhas</span>
                    <span class="badge bg-dark px-3 py-2 shadow-sm"
                          style="border-radius: 20px;">@ViewBag.RankingUsuario</span>
                </div>
                <p class="text-muted mb-0 mt-1">Seu progresso está crescendo como uma planta bem cuidada.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button onclick="location.reload()" class="btn btn-success fw-bold px-4 py-2 shadow-sm"
                        style="border-radius: 25px;">🔄 Atualizar Painel</button>
                <a asp-action="Create" class="btn btn-success fw-bold px-4 py-2 shadow-sm" style="border-radius: 25px;">Nova
                    Atividade</a>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5 d-flex flex-column gap-4">
                <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 20px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-success mb-0">Suas 4 Conquistas 🍀</h5>
                        <form asp-action="ResetarConquistas" method="post">
                            <button type="submit" class="btn btn-success fw-bold px-4 py-2 shadow-sm"
                                    style="border-radius: 25px;"
                                    onclick="return confirm('Tem certeza que deseja reiniciar suas conquistas?')">🔄
                                Reiniciar</button>
                            </form>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            @for (int i = 0; i < 4; i++)
                            {
                                var c = (conquistas != null && i < conquistas.Count) ? conquistas[i] : null;
                                <div class="text-center" style="width: 80px;" title="@(c?.Descricao ?? "Bloqueado")">
                                    <div class="bg-light p-3 rounded-circle shadow-sm d-flex align-items-center justify-content-center mx-auto mb-2"
                                         style="width: 60px; height: 60px; border: 2px solid @(c != null ? "#ffb300" : "#ccc");">
                                        <span class="fs-3">@(c != null ? "🏅" : "🔒")</span>
                                    </div>
                                    <span class="fw-bold text-dark d-block small lh-sm px-1"
                                          style="word-wrap: break-word; font-size: 0.8rem;">@(c?.Nome ?? "---")</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 20px;">
                        <h5 class="fw-bold text-success mb-3">Impacto por Categoria</h5>
                        <div style="position: relative; height: 250px; width: 100%;">
                            <canvas id="graficoCarbono"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7 d-flex flex-column gap-4">
                    <div class="card border-0 shadow-sm p-4"
                         style="border-radius: 20px; background-color: #a5d6a7; min-height: 320px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0">Desafio do Dia 🍀</h5>
                            <p class="text-success m-0 fw-bold">Total de acertos: @ViewBag.TotalAcertosQuiz</p>
                            <span class="badge bg-white text-success fw-bold px-3 py-2 shadow-sm"
                                  style="border-radius: 20px; font-size: 0.75rem;">ECO-GAME</span>
                        </div>

                        <div id="quiz-container" class="position-relative">
                            @if (perguntas != null && perguntas.Any())
                            {
                                for (int i = 0; i < perguntas.Count; i++)
                                {
                                    var p = perguntas[i];
                                    <div class="pergunta-card" id="pergunta-@i"
                                         style="display: @(i == 0 ? "block" : "none"); transition: opacity 0.4s ease;">
                                        <p class="fs-5 text-dark fw-semibold mb-4">@p.Pergunta</p>
                                        <div class="d-flex flex-column gap-3 mb-3">
                                            @for (int j = 0; j < p.Opcoes.Count; j++)
                                            {
                                                <button type="button" class="btn btn-light option-button"
                                                        onclick="processarResposta(@i, @p.Id, @j, @p.RespostaCorretaIndice, '@p.Explicacao.Replace("'", "\\'")')">
                                                    @p.Opcoes[j]
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5 bg-white rounded shadow-sm">
                                    <h5 class="text-success fw-bold">🌱 Tudo limpo por hoje!</h5>
                                    <p class="text-muted small">Volte amanhã para novos desafios.</p>
                                </div>
                            }
                            <div id="resultado-quiz" class="p-3 mt-3 shadow-sm font-medium small"
                                 style="display: none; border-radius: 15px; background-color: #fff;"></div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 20px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-success mb-0">Histórico de Atividades</h5>
                            <a asp-action="Historico"
                               class="btn btn-link text-success fw-semibold p-0 text-decoration-none small">Ver Completo →</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary">
                                    <tr>
                                        <th class="border-0">Atividade</th>
                                        <th class="border-0 text-center">Total (kgCO₂)</th>
                                        <th class="border-0 text-end">Data</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model.Take(5))
                                        {
                                            <tr>
                                                <td class="fw-semibold text-dark">@(item.AtividadeRelacionada?.Nome ?? "Outros")</td>
                                                <td class="text-center fw-bold text-danger">@((item.EmissaoTotal ?? 0).ToString("F2"))</td>
                                                <td class="text-end text-muted small">@(item.DataRegistro?.ToString("dd/MM/yyyy") ?? "Sem data")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-3 small">Nenhuma atividade registrada.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                .option-button {
                    transition: 0.3s;
                }

                .option-button:hover:not(:disabled) {
                    background-color: #e8f5e9 !important;
                    transform: translateY(-2px);
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
                }
            </style>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('graficoCarbono').getContext('2d');
        const labels = @Html.Raw(Json.Serialize(ViewBag.DadosGrafico.labels));
const valores = @Html.Raw(Json.Serialize(ViewBag.DadosGrafico.valores));
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: valores,
                    backgroundColor: ['#FF5722', '#FFC107', '#9C27B0', '#00BCD4', '#4CAF50', '#BF360C']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
    label: function (context) {
    let label = context.label || '';
    // Corrigindo a forma de pegar o valor
    let value = context.parsed !== null ? context.parsed : 0; 
    
    // Calcula o total somando todos os valores do dataset
    let total = context.dataset.data.reduce((a, b) => a + b, 0);
    
    // Calcula a porcentagem
    let percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
    
    return `${label}: ${value.toFixed(2)} kgCO₂ (${percentage}%)`;
}
                        }
                    }
                }
            }
        });
    });

    window.processarResposta = function (cardIdx, questaoRealId, escolhida, correta, explicacao) {
        const acertou = (escolhida === correta);
        const resDiv = document.getElementById("resultado-quiz");
        resDiv.style.backgroundColor = acertou ? "#c8e6c9" : "#ffecb3";
        resDiv.innerHTML = `<div style="padding: 15px;">${acertou ? "🍀 <strong>Perfeito!</strong>" : "🌿 <strong>Quase lá!</strong>"} ${explicacao}<br><br><button type="button" class="btn btn-success w-100" onclick="proximaPergunta(${cardIdx})">Avançar ➡️</button></div>`;
        resDiv.style.display = "block";

        fetch('/Atividade/ValidarRespostaQuiz', { 
            method: 'POST', 
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, 
            body: `questaoIndice=${questaoRealId}&alternativaEscolhida=${escolhida}` 
        }).then(() => {
            console.log("Resposta registrada no banco com sucesso!");
        });
    };

    window.proximaPergunta = function (cardIdx) {
        document.getElementById("pergunta-" + cardIdx).style.display = "none";
        document.getElementById("resultado-quiz").style.display = "none";
        const proxima = document.getElementById("pergunta-" + (cardIdx + 1));
        if (proxima) {
            proxima.style.display = "block";
        } else {
            document.getElementById("quiz-container").innerHTML = 
                "<div class='alert alert-success'>Parabéns! Você completou o desafio do dia. 🎉</div>";
        }
    };
</script>