@{
    ViewData["Title"] = "Mapa Ecológica";
    int posicao = ViewBag.PosicaoNoMapa;
}

<style>
    .tabuleiro-ajustado {
        position: relative;
        display: inline-block;
        width: 100%;
        max-width: 1000px;
    }

    .imagem-mapa-cheia {
        width: 100%;
        display: block;
        border-radius: 12px;
    }

    .peao {
        position: absolute;
        z-index: 99;
        transition: all 0.8s ease-in-out;
        transform: translate(-50%, -100%);
        width: 60px;
        text-align: center;
    }

    /* Esta linha garante que, se ele não souber para onde ir, ele fica no início */
    .peao {
        left: 29%;
        top: 31%;
    }

    /* POSIÇÕES CHAVE - O avatar vai pular para estas coordenadas */
    .peao-posicao-15 {
        left: 40%;
        top: 50%;
    }

    .peao-posicao-30 {
        left: 50%;
        top: 70%;
    }

    .peao-posicao-48 {
        left: 58%;
        top: 82%;
    }

    .peao-avatar img {
        width: 40px;
        height: 40px;
    }

    .peao-label {
        background: #dc3545;
        color: white;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 8px;
        border-radius: 4px;
    }
</style>

<div class="mapa-container-expandido text-center mt-3">
    <div class="tabuleiro-ajustado">
        <img src="~/img/mapa-tabuleiro2.jpg" class="imagem-mapa-cheia" alt="Tabuleiro">

        <div class="peao peao-posicao-@posicao">
            <div class="peao-avatar">
                <img src="https://cdn-icons-png.flaticon.com/512/188/188333.png" alt="Brotinho">
            </div>
            <div class="peao-label">VOCÊ</div>
        </div>
    </div>
</div>