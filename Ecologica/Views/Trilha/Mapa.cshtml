@{
    ViewData["Title"] = "Mapa Ecológica";
    int posicao = ViewBag.PosicaoNoMapa;
}

<style>
    .mapa-container-total {
        width: 100vw;
        height: calc(100vh - 120px);
        margin: 0;
        padding: 0;
        position: relative;
        background-color: #d0f2d3;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .imagem-mapa-cheia {
        width: 95vw;
        height: auto;
        max-height: 85vh;
        object-fit: contain;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
    }

    .mapa-wrapper {
        position: relative;
        display: inline-block;
    }

    .peao {
        position: absolute;
        z-index: 99;
        text-align: center;
        transition: all 0.8s ease-in-out;
        width: 60px;
        margin-left: -30px;
        margin-top: -50px;
    }

    .peao-avatar img {
        width: 45px;
        height: 45px;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
    }

    .peao-label {
        background: #dc3545;
        color: white;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 8px;
        border-radius: 4px;
        margin-top: 4px;
        text-transform: uppercase;
    }
</style>

<div class="mapa-container-total">
    <div class="mapa-wrapper">
        <img src="~/img/mapa-tabuleiro.jpg" class="imagem-mapa-cheia" alt="Tabuleiro">

        <div class="peao" style="left: @(29 + (posicao * 0.6))%; top: @(31 + (posicao * 1.0))%;">
            <div class="peao-avatar">
                <img src="https://cdn-icons-png.flaticon.com/512/188/188333.png" alt="Brotinho">
            </div>
            <div class="peao-label">VOCÊ</div>
        </div>
    </div>
</div>