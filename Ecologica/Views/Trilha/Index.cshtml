@model IEnumerable<Ecologica.Models.TrilhaConhecimento>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Trilha do Conhecimento";
}

@* Cabeçalho de Status *@
<div style="display: flex; justify-content: space-between; align-items: center; padding: 15px; background-color: #f0fdf4; border-radius: 15px; margin-bottom: 20px; border: 1px solid #dcfce7; max-width: 700px; margin-left: auto; margin-right: auto;">
    <div>
        <span style="font-weight: bold; color: #166534; margin-right: 10px;">Vidas:</span>
        @for (int i = 0; i < ViewBag.ArvoresVidas; i++)
        {
            <img src="~/img/tree.png" width="22" style="margin-right: 3px;" alt="Vida" />
        }
    </div>
    <div style="font-weight: bold; color: #166534;">
        Pontos: 150 XP 🌿
    </div>
</div>

<div class="mapa-container">
    <h2 class="text-center mb-4" style="color: #14532d; font-weight: bold;">Trilha Ecológica</h2>

    @{
        var lista = Model.ToList();
    }
    @for (int i = 0; i < lista.Count; i++)
    {
        var etapa = lista[i];
        <div class="ponto-estrada @(i % 2 == 0 ? "esquerda" : "direita")">
            
            <div class="caminho-wrapper">
                <div class="etapa-visual">
                    <div class="base-terra"></div>
                    <img src="~/img/@etapa.ObterImagemProgresso()" 
                         class="imagem-etapa @(etapa.EstaBloqueado ? "grayscale" : "")" />
                    
                    @if (etapa.EstaBloqueado)
                    {
                        <div class="cadeado-mini">🔒</div>
                    }
                </div>

                <div class="etapa-info">
                    <h6 class="titulo-etapa">@etapa.Titulo</h6>
                    @if (!etapa.EstaBloqueado)
                    {
                        <a asp-action="Detalhes" asp-route-id="@etapa.Id" class="btn-jogar">
                            @(etapa.Progresso >= 1.0 ? "Revisar" : "Jogar")
                        </a>
                    }
                    else
                    {
                        <span class="badge-bloqueado">🔒</span>
                    }
                </div>
            </div>

            @* Curva da Estrada - Ajustada para ser mais compacta *@
            @if (i < lista.Count - 1)
            {
                <div class="curva-estrada"></div>
            }
        </div>
    }
</div>

<style>
    .mapa-container {
        position: relative;
        max-width: 500px; /* Reduzi a largura total para aproximar as curvas */
        margin: 0 auto;
        padding: 20px 0;
    }

    .ponto-estrada {
        position: relative;
        width: 100%;
        display: flex;
        margin-bottom: 60px; /* Reduzi a distância vertical entre as lições */
    }

    .ponto-estrada.esquerda { justify-content: flex-start; padding-left: 20px; }
    .ponto-estrada.direita { justify-content: flex-end; padding-right: 20px; }

    .caminho-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 10;
        width: 150px; /* Reduzi a largura do container do item */
    }

    .etapa-visual {
        position: relative;
        width: 100px;
        height: 100px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .base-terra {
        position: absolute;
        bottom: 5px;
        width: 70px;
        height: 20px;
        background: #c3a683;
        border-radius: 50%;
        opacity: 0.5;
        z-index: 1;
    }

    .imagem-etapa {
        width: 75px; /* Árvores um pouco menores para caber no espaço compacto */
        z-index: 5;
        transition: transform 0.2s ease;
    }

    .ponto-estrada:hover .imagem-etapa:not(.grayscale) {
        transform: scale(1.15) translateY(-5px);
    }

    .grayscale { filter: grayscale(1) opacity(0.6); }

    /* Estrada compacta e sinuosa */
    .curva-estrada {
        position: absolute;
        height: 100px; /* Ajustado para a nova distância vertical */
        border: 15px solid #d1d5db; /* Estrada um pouco mais fina */
        z-index: 1;
        pointer-events: none;
    }

    /* Curva para a direita */
    .ponto-estrada.esquerda .curva-estrada {
        border-radius: 0 60px 60px 0;
        border-left: 0;
        border-bottom: 0;
        left: 85px; /* Alinhado ao centro da árvore */
        top: 50px;
        width: calc(100% - 85px);
    }

    /* Curva para a esquerda */
    .ponto-estrada.direita .curva-estrada {
        border-radius: 60px 0 0 60px;
        border-right: 0;
        border-bottom: 0;
        right: 85px;
        top: 50px;
        width: calc(100% - 85px);
    }

    .titulo-etapa { 
        color: #14532d; 
        font-weight: bold; 
        font-size: 0.95rem; 
        margin-top: 8px; 
        text-align: center; 
        line-height: 1.1;
    }
    
    .btn-jogar {
        background: #28a745;
        color: white;
        text-decoration: none;
        padding: 5px 15px;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: bold;
        box-shadow: 0 3px 0 #1e7e34;
        transition: all 0.1s;
        margin-top: 5px;
    }

    .btn-jogar:active {
        transform: translateY(2px);
        box-shadow: 0 1px 0 #1e7e34;
    }

    .badge-bloqueado {
        color: #94a3b8;
        font-size: 1.2rem;
    }

    .cadeado-mini {
        position: absolute;
        top: 5px;
        right: 5px;
        font-size: 1.2rem;
        z-index: 6;
    }
</style>