@model Ecologica.Models.TrilhaConhecimento

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Titulo;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 p-4" style="border-radius: 25px; background-color: #ffffff;">
                <div class="text-center">
                    @* A imagem evolui: semente -> broto -> árvore *@
                    <div class="mb-3" style="background: #f0fdf4; display: inline-block; padding: 20px; border-radius: 50%;">
                        <img src="~/img/@Model.ObterImagemProgresso()" width="100" alt="Progresso da Lição" />
                    </div>
                    
                    <h2 class="text-success fw-bold">@Model.Titulo</h2>
                    <div style="width: 60px; height: 4px; background-color: #28a745; margin: 15px auto; border-radius: 10px;"></div>
                </div>

                @* Conteúdo da Lição *@
                <div class="mt-4 p-3" style="font-size: 1.15rem; line-height: 1.8; color: #2d3748; text-align: justify;">
                    @Model.Descricao
                </div>

                <div class="text-center mt-5">
                    @* Este formulário chama o método que criamos no Controller *@
                    <form asp-action="ConcluirEtapa" asp-controller="Trilha" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm fw-bold" 
                                style="border-radius: 15px; transition: 0.3s;">
                            Concluir esta Lição 🍀
                        </button>
                    </form>
                    
                    <div class="mt-3">
                        <a asp-action="Index" class="text-muted text-decoration-none small">
                            <i class="bi bi-arrow-left"></i> Voltar para o mapa da trilha
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Efeito de hover no botão para dar um feedback visual */
    .btn-success:hover {
        transform: scale(1.05);
        background-color: #1e7e34;
    }
</style>