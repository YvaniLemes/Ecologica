@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecologica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-success fw-bold" href="/Home/Index">🍀 Ecologica</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UsuarioNome")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Home/Index">Início</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Atividade/Historico">Meu Histórico</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Atividade/Create">Novo Cálculo</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Trilha/Index">Trilha Ecologica</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-success" asp-controller="Trilha" asp-action="Mapa">🗺️ Mapa
                                    Ecologica</a>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav">
                            @if (!string.IsNullOrEmpty(Context.Session.GetString("UsuarioNome")))
                            {
                                <li class="nav-item d-flex align-items-center">
                                    <span class="nav-link text-dark fw-bold me-3">Olá,
                                        @Context.Session.GetString("UsuarioNome")!</span>
                                    </li>

                                    @* VERIFICAÇÃO DE ROTA PARA DEFINIR O COMPORTAMENTO DO BOTÃO DE NAVEGAÇÃO *@
                                    if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Atividade" &&
                                ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link text-danger fw-bold" href="/Usuario/Logout">Sair</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link text-danger fw-bold" href="/Atividade/Index">Voltar</a>
                                        </li>
                                    }
                                }
                            </ul>

                        </div>
                    </div>
                </nav>
            </header>

            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted text-center">
                <div class="container">
                    &copy; 2026 - Ecologica - Sustentabilidade Digital
                </div>
            </footer>

            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>