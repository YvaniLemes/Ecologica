@model CARBONO.V3._1.Models.RegistroCarbono

<div class="container">
    <h2>Editar Registro</h2>
    <hr />
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div class="form-group mb-3">
            <label class="control-label">Tipo de Atividade</label>
            <select asp-for="IdAtividade" class="form-control" 
                    asp-items="@(new SelectList(ViewBag.ListaAtividades, "Id", "Nome"))"></select>
        </div>
        <div class="form-group mb-3">
            <label class="control-label">Quantidade (km ou kWh)</label>
            <input asp-for="Quantidade" class="form-control" />
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>