@model IEnumerable<CARBONO.V3._1.Models.RegistroCarbono>

<div class="container">
    <h2>Meu Histórico de Carbono</h2>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Atividade</th>
                <th>Quantidade</th>
                <th>Total (kgCO2)</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var registro in Model)
            {
                <tr>
                    <td>@(registro.AtividadeRelacionada?.Nome ?? "N/A")</td>
                    <td>@registro.Quantidade</td>
                    <td>@registro.EmissaoTotal.ToString("N2")</td>
                    <td>@registro.DataRegistro.ToShortDateString()</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@registro.Id" class="btn btn-primary btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@registro.Id" class="btn btn-danger btn-sm">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Create" class="btn btn-success">Nova Atividade</a>
</div>